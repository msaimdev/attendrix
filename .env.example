# Copy this file to .env and replace the placeholders.
# Never commit your real .env file.

# Generate a random secret for session signing.
# Example command: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace_with_a_random_secret

# Email settings (required by the current application configuration).
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=replace_with_your_email_app_password
SMTP_FROM=your_email@example.com

# Optional defaults:
# APP_NAME=Face Attendance System
# APP_VERSION=1.0.0
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8000
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# ATTENDANCE_CAMERA_INDEX=0
# REGISTRATION_CAMERA_INDEX=0
# ATTENDANCE_PREVIEW_WINDOW=false
